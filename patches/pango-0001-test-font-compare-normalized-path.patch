       if (FcPatternGetString (pattern, FC_FILE, 0, (FcChar8 **)&filename) != FcResultMatch)
         filename = "tough luck";
 
-      g_assert_cmpstr (filename, ==, path);
+      /* fontconfig normalizes separators to '/', while g_test_build_filename
