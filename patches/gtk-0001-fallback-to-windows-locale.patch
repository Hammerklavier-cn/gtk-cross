--- a/gtk/gtktestutils.c
+++ b/gtk/gtktestutils.c
@@ -83,6 +83,14 @@
   gtk_disable_setlocale();
   lang = setlocale (LC_ALL, "en_US.UTF-8");
   if (lang == NULL)
+    {
+      /* msvcrt (the mingw32 targets) knows no UTF-8 locale and not the POSIX
+       * locale names, so fall back to the Windows name for the same language.
+       * Avoiding the warning matters: g_test_init() makes warnings fatal, so
+       * the g_warning() below would abort every test before it starts. */
+      lang = setlocale (LC_ALL, "English_United States.1252");
+    }
+  if (lang == NULL)
     g_warning ("Failed to set locale to en_US.UTF-8");
   else if (g_test_verbose ())
     g_test_message ("language: %s", lang);
