From: gtk-cross <noreply@localhost>
Subject: [PATCH] Build libpng test suite against the static library

上游把整个测试段门控在 `if(PNG_TESTS AND PNG_SHARED)` 上，且测试程序与
测试运行脚本硬编码 png_shared 目标（add_test 的 LIBPNG_FILE、
$<TARGET_FILE:png_shared>）。本项目以 PNG_SHARED=OFF、PNG_STATIC=ON 构建
（只产出静态库），于是 37 项自带测试被静默跳过，测试覆盖归零。

改为门控在 PNG_LIBRARY_TARGETS 上，并按实际构建的变体选择测试链接目标
（shared → png_shared / static → png_static / framework → png_framework），
测试运行脚本亦改用该变量。PNG_TOOLS 段（pngfix/png-fix-itxt）保持原样，
因上游同样要求 PNG_SHARED，且本项目未启用这些工具。

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -758,7 +758,17 @@
                      "PNG_SHARED, PNG_STATIC, PNG_FRAMEWORK")
 endif()
 
-if(PNG_TESTS AND PNG_SHARED)
+if(PNG_TESTS AND PNG_LIBRARY_TARGETS)
+  # Upstream gates the whole test suite on PNG_SHARED and links every test
+  # program against the png_shared target, so a static-only build would lose
+  # all tests.  Choose whichever variant was built and link the tests to it.
+  if(PNG_SHARED)
+    set(PNG_TEST_LIBRARY png_shared)
+  elseif(PNG_STATIC)
+    set(PNG_TEST_LIBRARY png_static)
+  else()
+    set(PNG_TEST_LIBRARY png_framework)
+  endif()
   enable_testing()
 
   # Include the internal module PNGTest.cmake
@@ -779,7 +789,7 @@
   # Basic read/write roundtrip using the sequential API.
   add_executable(pngtest ${pngtest_sources})
   target_link_libraries(pngtest
-                        PRIVATE png_shared)
+                        PRIVATE ${PNG_TEST_LIBRARY})
 
   png_add_test(NAME pngtest
                COMMAND pngtest
@@ -793,7 +803,7 @@
   # Getter-to-setter roundtrips for various chunk types.
   add_executable(pnggetset ${pnggetset_sources})
   target_link_libraries(pnggetset
-                        PRIVATE png_shared)
+                        PRIVATE ${PNG_TEST_LIBRARY})
 
   png_add_test(NAME pnggetset
                COMMAND pnggetset)
@@ -803,7 +813,7 @@
   # transforms, and gamma handling.
   add_executable(pngvalid ${pngvalid_sources})
   target_link_libraries(pngvalid
-                        PRIVATE png_shared)
+                        PRIVATE ${PNG_TEST_LIBRARY})
 
   png_add_test(NAME pngvalid-gamma-16-to-8
                COMMAND pngvalid
@@ -853,7 +863,7 @@
   # by gamma type and alpha type.
   add_executable(pngstest ${pngstest_sources})
   target_link_libraries(pngstest
-                        PRIVATE png_shared)
+                        PRIVATE ${PNG_TEST_LIBRARY})
 
   foreach(gamma_type 1.8 linear none sRGB)
     foreach(alpha_type none alpha)
@@ -951,7 +961,7 @@
   # Unknown chunk handling under various read policies.
   add_executable(pngunknown ${pngunknown_sources})
   target_link_libraries(pngunknown
-                        PRIVATE png_shared)
+                        PRIVATE ${PNG_TEST_LIBRARY})
 
   png_add_test(NAME pngunknown-discard
                COMMAND pngunknown
@@ -987,7 +997,7 @@
   # Image read validation against the pngsuite corpus.
   add_executable(pngimage ${pngimage_sources})
   target_link_libraries(pngimage
-                        PRIVATE png_shared)
+                        PRIVATE ${PNG_TEST_LIBRARY})
 
   png_add_test(NAME pngimage-quick
                COMMAND pngimage
--- a/scripts/cmake/PNGTest.cmake
+++ b/scripts/cmake/PNGTest.cmake
@@ -36,7 +36,7 @@
                  @ONLY)
   add_test(NAME "${_PAT_NAME}"
            COMMAND "${CMAKE_COMMAND}"
-                   "-DLIBPNG=$<TARGET_FILE:png_shared>"
+                   "-DLIBPNG=$<TARGET_FILE:${PNG_TEST_LIBRARY}>"
                    "-DTEST_COMMAND=$<TARGET_FILE:${_PAT_COMMAND}>"
                    -P "${CMAKE_CURRENT_BINARY_DIR}/tests/${_PAT_NAME}.cmake")
 endfunction()
